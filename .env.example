# HALO environment template (no real secrets)
# Copy to `.env` on the VPS / local machine and fill in values.

CRM_BACKEND=supabase
WORKSPACE_ID=default
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
HALO_SESSION_SECRET=
DASHBOARD_PUBLIC_URL=
OPENAI_API_KEY=
# Shared platform Apify pool (operators only — not shown in user Integrations)
APIFY_TOKEN_1=
APIFY_TOKEN_2=
APIFY_TOKEN_3=
APIFY_TOKEN_4=
APIFY_TOKEN_5=
APIFY_TOKEN_6=
# Optional legacy single token / comma list:
# APIFY_TOKEN=
# APIFY_TOKENS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
ALLOW_AUTO_LOGIN=0
