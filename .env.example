# HALO environment template (no real secrets)
# Copy to `.env` on the VPS / local machine and fill in values.

CRM_BACKEND=supabase
WORKSPACE_ID=default
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DASHBOARD_USER=admin
# Required. With no DASHBOARD_PASSWORD and no cabinet session the dashboard
# refuses the request (it used to serve everything unauthenticated).
DASHBOARD_PASSWORD=
# Session cookie HMAC key, >= 32 chars. Leave blank and the dashboard generates
# one on first boot and writes it back here. Never reuse DASHBOARD_PASSWORD.
HALO_SESSION_SECRET=
DASHBOARD_PUBLIC_URL=
OPENAI_API_KEY=
# Shared platform Apify pool (operators only — not shown in user Integrations)
APIFY_TOKEN_1=
APIFY_TOKEN_2=
APIFY_TOKEN_3=
APIFY_TOKEN_4=
APIFY_TOKEN_5=
APIFY_TOKEN_6=
# Optional legacy single token / comma list:
# APIFY_TOKEN=
# APIFY_TOKENS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Required for billing. Webhooks are rejected (503) until this is set, and every
# delivery must carry a valid stripe-signature — the endpoint is public, so the
# signature is the only thing preventing forged "subscription active" events.
STRIPE_WEBHOOK_SECRET=
# Comma-separated emails that always see the Admin panel (any cabinet they open).
# Built-in team list also includes wafficompany@ / uroki.online2020@ / ddacisin@.
# HALO_PLATFORM_ADMIN_EMAILS=
ALLOW_AUTO_LOGIN=0
